//@version=6
// @description First presented FVGs of the New York session, extended right: FPFVG (first FVG in 09:30-10:00), FPDFVG (first one with displacement), FPRFVG (first opposite FVG after the FPFVG) and the Silver Bullet FPFVG (first FVG in 10:00-11:00). Shows the last week by default. Each day's pick can be corrected or hidden in Settings > Fix a day.
indicator("TVE First Presented FVGs", "TVE FPFVG", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// @tve-body  (everything below this line is copied into TVE All-in-One, so names start with fp_)

fp_TZ = "America/New_York"
fp_G = "First presented FVGs"
fp_all      = input.bool(true, "Show first presented FVGs", group = fp_G, tooltip = "Untick to turn all of them off. The switches below turn each type on or off.")
fp_days     = input.int(5, "Days to show", minval = 1, maxval = 60, group = fp_G)
fp_win      = input.session("0930-1000", "FPFVG window (NY)", group = fp_G)
fp_sbWin    = input.session("1000-1100", "Silver Bullet window (NY)", group = fp_G)
fp_dispMult = input.float(1.5, "Displacement: middle candle body ≥ x average body", minval = 0.5, step = 0.1, group = fp_G, tooltip = "Average of the last 20 candle bodies. Used for FPDFVG.")
fp_minTicks = input.int(0, "Minimum gap (ticks)", minval = 0, group = fp_G)
fp_tfIn     = input.timeframe("1", "Find gaps on", group = fp_G, tooltip = "Candle size the gaps are looked for on, whatever the chart's timeframe, so they stay the same when you switch timeframes. A chart with smaller candles uses its own.")
fp_showCE   = input.bool(true, "CE (50%) line", group = fp_G)
fp_showDay  = input.bool(true, "Weekday in label", group = fp_G)

fp_on0  = input.bool(true, "FPFVG", inline = "t0", group = fp_G)
fp_col0 = input.color(color.new(#FFC857, 78), "", inline = "t0", group = fp_G)
fp_on1  = input.bool(true, "FPDFVG", inline = "t1", group = fp_G)
fp_col1 = input.color(color.new(#FF8A3D, 75), "", inline = "t1", group = fp_G)
fp_on2  = input.bool(true, "FPRFVG", inline = "t2", group = fp_G)
fp_col2 = input.color(color.new(#B388FF, 80), "", inline = "t2", group = fp_G)
fp_on3  = input.bool(true, "SB FPFVG", inline = "t3", group = fp_G)
fp_col3 = input.color(color.new(#22D3EE, 80), "", inline = "t3", group = fp_G)

// Corrections. FPFVGs are discretionary: point a slot at the middle candle of the gap you want, or hide a day.
fp_GF = "Fix a day"
fp_TIP = "Use this candle: set the date and time of the middle (2nd) candle of the gap you want; it replaces that day's automatic pick. Hide that day: any time on that day."
fp_TYPES = array.from("FPFVG", "FPDFVG", "FPRFVG", "SB FPFVG")
fp_MODES = array.from("Off", "Use this candle", "Hide that day")
fp_m1 = input.string("Off", "1", options = ["Off", "Use this candle", "Hide that day"], inline = "f1", group = fp_GF)
fp_k1 = input.string("FPFVG", "", options = ["FPFVG", "FPDFVG", "FPRFVG", "SB FPFVG"], inline = "f1", group = fp_GF)
fp_t1 = input.time(timestamp("2026-01-05T09:31:00-05:00"), "", inline = "f1", group = fp_GF, tooltip = fp_TIP)
fp_m2 = input.string("Off", "2", options = ["Off", "Use this candle", "Hide that day"], inline = "f2", group = fp_GF)
fp_k2 = input.string("FPFVG", "", options = ["FPFVG", "FPDFVG", "FPRFVG", "SB FPFVG"], inline = "f2", group = fp_GF)
fp_t2 = input.time(timestamp("2026-01-05T09:31:00-05:00"), "", inline = "f2", group = fp_GF, tooltip = fp_TIP)
fp_m3 = input.string("Off", "3", options = ["Off", "Use this candle", "Hide that day"], inline = "f3", group = fp_GF)
fp_k3 = input.string("FPFVG", "", options = ["FPFVG", "FPDFVG", "FPRFVG", "SB FPFVG"], inline = "f3", group = fp_GF)
fp_t3 = input.time(timestamp("2026-01-05T09:31:00-05:00"), "", inline = "f3", group = fp_GF, tooltip = fp_TIP)
fp_m4 = input.string("Off", "4", options = ["Off", "Use this candle", "Hide that day"], inline = "f4", group = fp_GF)
fp_k4 = input.string("FPFVG", "", options = ["FPFVG", "FPDFVG", "FPRFVG", "SB FPFVG"], inline = "f4", group = fp_GF)
fp_t4 = input.time(timestamp("2026-01-05T09:31:00-05:00"), "", inline = "f4", group = fp_GF, tooltip = fp_TIP)
fp_m5 = input.string("Off", "5", options = ["Off", "Use this candle", "Hide that day"], inline = "f5", group = fp_GF)
fp_k5 = input.string("FPFVG", "", options = ["FPFVG", "FPDFVG", "FPRFVG", "SB FPFVG"], inline = "f5", group = fp_GF)
fp_t5 = input.time(timestamp("2026-01-05T09:31:00-05:00"), "", inline = "f5", group = fp_GF, tooltip = fp_TIP)

var fp_fixMode = array.from(fp_m1, fp_m2, fp_m3, fp_m4, fp_m5)
var fp_fixType = array.from(fp_k1, fp_k2, fp_k3, fp_k4, fp_k5)
var fp_fixTime = array.from(fp_t1, fp_t2, fp_t3, fp_t4, fp_t5)

fp_dayKey(int t) => year(t, fp_TZ) * 10000 + month(t, fp_TZ) * 100 + dayofmonth(t, fp_TZ)

// The correction for this type on this day: [mode, time] (mode "" when there is none).
fp_fix(int k, int dk) =>
    string mode = ""
    int t = na
    for i = 0 to 4
        if fp_fixMode.get(i) != "Off" and fp_fixType.get(i) == fp_TYPES.get(k) and fp_dayKey(fp_fixTime.get(i)) == dk
            mode := fp_fixMode.get(i)
            t := fp_fixTime.get(i)
    [mode, t]

fp_on(int k) => fp_all and (k == 0 ? fp_on0 : k == 1 ? fp_on1 : k == 2 ? fp_on2 : fp_on3)
fp_col(int k) => k == 0 ? fp_col0 : k == 1 ? fp_col1 : k == 2 ? fp_col2 : fp_col3

// Finds each type's gap for the day. Runs on fp_tf candles (see below), so the result is the same on every
// chart timeframe. Returns, per type: top, bottom, time of the 1st, 2nd and 3rd candle, and whether it was fixed.
fp_scan() =>
    var tops = array.new_float(4, na)
    var bots = array.new_float(4, na)
    var tLs  = array.new_int(4, na)
    var tMs  = array.new_int(4, na)
    var tRs  = array.new_int(4, na)
    var fixs = array.new_bool(4, false)
    var found = array.new_bool(4, false)
    var int curDay = na
    var int dir = 0     // direction of the day's FPFVG: 1 bull, -1 bear
    var int fpBar = na  // bar it formed on
    inWin = not na(time(timeframe.period, fp_win, fp_TZ))
    inSB  = not na(time(timeframe.period, fp_sbWin, fp_TZ))
    avgBody = ta.sma(math.abs(close - open), 20)
    minGap = fp_minTicks * syminfo.mintick
    bull = low > high[2] and low - high[2] >= minGap
    bear = high < low[2] and low[2] - high >= minGap
    disp = math.abs(close[1] - open[1]) >= fp_dispMult * nz(avgBody[2])
    dk = fp_dayKey(time[1])
    sameDay = fp_dayKey(time[2]) == dk
    if bar_index >= 2
        if na(curDay) or dk != curDay
            curDay := dk
            for i = 0 to 3
                found.set(i, false)
            dir := 0
            fpBar := na
        for k = 0 to 3
            if not found.get(k)
                [mode, ft] = fp_fix(k, dk)
                float top = na
                float bot = na
                bool fixed = false
                if mode == "Use this candle"
                    // The chosen middle candle is the previous bar: take the gap between candles 1 and 3,
                    // or the wicks around it if there's no clean gap.
                    if ft >= time[1] and ft < time
                        up = close[1] >= open[1]
                        top := up ? math.max(low, high[2]) : math.max(low[2], high)
                        bot := up ? math.min(low, high[2]) : math.min(low[2], high)
                        fixed := true
                        if k == 0
                            dir := up ? 1 : -1
                            fpBar := bar_index
                else if mode == ""
                    inW = k == 3 ? inSB[2] : inWin[2]
                    want = k == 2 ? (dir == 1 ? bear : dir == -1 ? bull : false) : bull or bear
                    if sameDay and inW and want and (k != 1 or disp) and (k != 2 or bar_index > nz(fpBar, bar_index))
                        top := bull ? low : low[2]
                        bot := bull ? high[2] : high
                        if k == 0
                            dir := bull ? 1 : -1
                            fpBar := bar_index
                if not na(top)
                    found.set(k, true)
                    tops.set(k, top)
                    bots.set(k, bot)
                    tLs.set(k, time[2])
                    tMs.set(k, time[1])
                    tRs.set(k, time)
                    fixs.set(k, fixed)
    [tops.get(0), bots.get(0), tLs.get(0), tMs.get(0), tRs.get(0), fixs.get(0),
     tops.get(1), bots.get(1), tLs.get(1), tMs.get(1), tRs.get(1), fixs.get(1),
     tops.get(2), bots.get(2), tLs.get(2), tMs.get(2), tRs.get(2), fixs.get(2),
     tops.get(3), bots.get(3), tLs.get(3), tMs.get(3), tRs.get(3), fixs.get(3)]

// Gaps are found on fp_tfIn candles (1 minute by default) on any intraday chart, so switching timeframes doesn't
// lose them. On a chart with smaller candles than that, the chart's own candles are used.
fp_tf = not timeframe.isintraday or timeframe.in_seconds() < timeframe.in_seconds(fp_tfIn) ? timeframe.period : fp_tfIn
[fp_top0, fp_bot0, fp_l0, fp_m0, fp_r0, fp_f0, fp_top1, fp_bot1, fp_l1, fp_m1x, fp_r1, fp_f1, fp_top2, fp_bot2, fp_l2, fp_m2x, fp_r2, fp_f2, fp_top3, fp_bot3, fp_l3, fp_m3x, fp_r3, fp_f3] = request.security(syminfo.tickerid, fp_tf, fp_scan(), lookahead = barmerge.lookahead_off)

var fp_boxes  = array.new<box>()
var fp_lines  = array.new<line>()
var fp_labels = array.new<label>()
var fp_objDay = array.new<int>()
var fp_dayList = array.new<int>()
var fp_lastR  = array.new_int(4, na)

fp_draw(int k, float top, float bot, int tL, int tM, int tR, bool fixed) =>
    // Draw each gap once, when it first shows up (its 3rd candle's time changes).
    if timeframe.isintraday and fp_on(k) and not na(tR) and (na(fp_lastR.get(k)) or tR != fp_lastR.get(k))
        fp_lastR.set(k, tR)
        dk = fp_dayKey(tM)
        c = fp_col(k)
        border = color.new(c, 0)
        txt = fp_TYPES.get(k) + (fp_showDay ? " " + str.format_time(tM, "EEE", fp_TZ) : "") + (fixed ? " ✎" : "")
        b = box.new(tL, top, tR, bot, xloc = xloc.bar_time, extend = extend.right, border_color = border, bgcolor = c)
        mid = (top + bot) / 2
        l = fp_showCE ? line.new(tL, mid, tR, mid, xloc = xloc.bar_time, extend = extend.right, color = border, style = line.style_dashed) : na
        // The name sits at the right end, next to the price scale (moved along on the last bar below).
        fp_labels.push(label.new(tR, mid, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 100), textcolor = border, size = size.small))
        fp_boxes.push(b)
        fp_lines.push(l)
        fp_objDay.push(dk)
        if fp_dayList.size() == 0 or fp_dayList.last() != dk
            fp_dayList.push(dk)
        // Keep only the last fp_days days that have drawings.
        while fp_dayList.size() > fp_days
            old = fp_dayList.shift()
            for i = fp_objDay.size() - 1 to 0
                if fp_objDay.get(i) == old
                    fp_boxes.get(i).delete()
                    fp_lines.get(i).delete()
                    fp_labels.get(i).delete()
                    fp_boxes.remove(i)
                    fp_lines.remove(i)
                    fp_labels.remove(i)
                    fp_objDay.remove(i)

fp_draw(0, fp_top0, fp_bot0, fp_l0, fp_m0, fp_r0, fp_f0)
fp_draw(1, fp_top1, fp_bot1, fp_l1, fp_m1x, fp_r1, fp_f1)
fp_draw(2, fp_top2, fp_bot2, fp_l2, fp_m2x, fp_r2, fp_f2)
fp_draw(3, fp_top3, fp_bot3, fp_l3, fp_m3x, fp_r3, fp_f3)

// On the latest candle: end every box and CE line there (they still extend right) and put the names just past it.
// TradingView hides a drawing whose candles aren't loaded yet, which on small timeframes is anything older than a
// few hours until you scroll back; ending them on the latest candle keeps them on screen at every zoom.
if barstate.islast
    fp_x = time + 2 * timeframe.in_seconds() * 1000
    for b in fp_boxes
        b.set_right(time)
    for l in fp_lines
        if not na(l)
            l.set_x2(time)
    for l in fp_labels
        l.set_x(fp_x)
